# Annapurna Memorial College ERP - Environment Variables
PROJECT_NAME="Annapurna Memorial College ERP"
COLLEGE_LEGAL_NAME="Annapurna Memorial College & Sundarban Ashutosh B.Ed. College"
ENVIRONMENT="production"

# Server
HOST="0.0.0.0"
PORT=8000

# Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="annapurna_erp_db"

# Security & JWT Secret
JWT_SECRET_KEY="annapurna-memorial-college-super-secret-jwt-key-2026-production-grade"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Third-party Integrations (Graceful Fallback if blank)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="annapurna_college_erp"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Annapurna College <notifications@annapurnacollege.org>"

FIREBASE_CREDENTIALS_PATH=""

# Superadmin Default Credentials
DEFAULT_ADMIN_EMAIL="admin@annapurnacollege.org"
DEFAULT_ADMIN_PASSWORD="Admin@123456"
DEFAULT_ADMIN_NAME="Principal Arnab Senapati"
